# ==============================================================================
# CureHealth - Root Docker Compose Environment Template
# ==============================================================================
# Copy this file to .env (or configure in your CI/CD deployment environment)
# ==============================================================================

# Ports
FRONTEND_PORT=80
BACKEND_PORT=5000

# Backend Configuration (Stored in backend/.env)
NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hmywqhf.mongodb.net/curehealth
CLIENT_URL=http://localhost
JWT_SECRET=super_secret_curehealth_jwt_key_2026

# AWS S3 Storage for Prescriptions & Avatars
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET_NAME=curehealthstore

# Razorpay Payment Gateway (Test / Live Mode)
RAZORPAY_KEY_ID=rzp_test_TLLJHoZKSG6nBe
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Optional: Custom DNS servers (only needed if local ISP blocks/drops MongoDB Atlas SRV records)
# CUSTOM_DNS_SERVERS=8.8.8.8,1.1.1.1

# Frontend Build Arguments
VITE_API_BASE_URL=/api
VITE_RAZORPAY_KEY_ID=rzp_test_TLLJHoZKSG6nBe
